{
  "id": "ruby_control",
  "title": "Ruby Control Panel",

  "width": 220,
  "height": 150,

  "backgroundColor": "#CC181818",
  "titleColor": "#FF5555",

  "variables": {
    "power": 0,
    "enabled": false
  },

  "rectangles": [
    {
      "x": 15,
      "y": 35,
      "width": 190,
      "height": 80,
      "color": "#AA000000"
    }
  ],

  "labels": [
    {
      "text": "Hello ${player}",
      "x": 20,
      "y": 43,
      "color": "#FFFFFF"
    },
    {
      "text": "Block: ${x}, ${y}, ${z}",
      "x": 20,
      "y": 56,
      "color": "#AAAAAA"
    },
    {
      "text": "Power: ${power} / 100",
      "x": 20,
      "y": 70,
      "color": "#FFFFFF"
    },
    {
      "text": "ACTIVE",
      "x": 175,
      "y": 70,
      "color": "#55FF55",
      "visibleWhen": {
        "var": "enabled",
        "equals": true
      }
    }
  ],

  "progressBars": [
    {
      "x": 20,
      "y": 84,
      "width": 180,
      "height": 8,
      "variable": "power",
      "max": 100,
      "backgroundColor": "#FF303030",
      "fillColor": "#FFFF5555"
    }
  ],

  "buttons": [
    {
      "id": "add_power",
      "text": "+10 Power",
      "x": 20,
      "y": 102,
      "width": 80,
      "height": 20,

      "actions": [
        {
          "type": "addVar",
          "name": "power",
          "value": 10
        },

        {
          "type": "if",
          "condition": {
            "var": "power",
            "greaterOrEqual": 100
          },

          "then": [
            {
              "type": "setVar",
              "name": "power",
              "value": 100
            },

            {
              "type": "message",
              "text": "Ruby machine reached full power!"
            },

            {
              "type": "playSound",
              "sound": "random.levelup",
              "volume": 1.0,
              "pitch": 1.0
            }
          ]
        }
      ]
    },

    {
      "id": "toggle",
      "text": "Toggle",
      "x": 105,
      "y": 102,
      "width": 55,
      "height": 20,

      "actions": [
        {
          "type": "toggleVar",
          "name": "enabled"
        }
      ]
    },

    {
      "id": "reset",
      "text": "Reset",
      "x": 165,
      "y": 102,
      "width": 40,
      "height": 20,

      "actions": [
        {
          "type": "setVar",
          "name": "power",
          "value": 0
        },

        {
          "type": "setVar",
          "name": "enabled",
          "value": false
        }
      ]
    },

    {
      "id": "close",
      "text": "Done",
      "x": 60,
      "y": 126,
      "width": 100,
      "height": 20,

      "action": {
        "type": "close"
      }
    }
  ]
}
